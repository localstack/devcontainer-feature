{
    "latest_on_bookworm": {
        "image": "mcr.microsoft.com/devcontainers/base:bookworm",
        "user": "vscode",
        "features": {
            "localstack-cli": {}
        }
    },
    "pinned_version_on_noble": {
        "image": "mcr.microsoft.com/devcontainers/base:noble",
        "user": "vscode",
        "features": {
            "localstack-cli": {
                "version": "1.4.5"
            }
        }
    },
    "pinned_version_with_v_prefix": {
        "image": "mcr.microsoft.com/devcontainers/base:jammy",
        "user": "vscode",
        "features": {
            "localstack-cli": {
                "version": "v1.4.4"
            }
        }
    },
    "slim_image_without_curl": {
        "image": "debian:trixie-slim",
        "features": {
            "localstack-cli": {}
        }
    },
    "alpine": {
        "image": "mcr.microsoft.com/devcontainers/base:alpine",
        "user": "vscode",
        "features": {
            "localstack-cli": {}
        }
    },
    "with_docker_and_aws_cli": {
        "image": "mcr.microsoft.com/devcontainers/base:bookworm",
        "user": "vscode",
        "features": {
            "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
            "ghcr.io/devcontainers/features/aws-cli:1": {},
            "localstack-cli": {}
        }
    },
    "pulumilocal": {
        "image": "mcr.microsoft.com/devcontainers/base:bookworm",
        "user": "vscode",
        "features": {
            "ghcr.io/devcontainers-extra/features/pulumi:1": {},
            "localstack-cli": {
                "pulumilocal": true
            }
        }
    }
}
